+def borrow_spare(drafts: list[list[int]], copied: list[bool], cap: int, turn: int) -> tuple[list[list[int]], list[int]]:
+    """Keep the original window for each stream. Use leftover verify rows for longer learned proposals."""
+    count = len(drafts)
+    share = cap // count - 1
+    ordinary = trim([chain if copy else chain[:share] for chain, copy in zip(drafts, copied)], cap)
+    lengths = [len(chain) for chain in ordinary]
+    before = lengths.copy()
+    left = cap - count - sum(lengths)
+    # Rotate who gets a contested row. Append only to prefixes, preserving both copying and the keyed draws.
+    while left > 0:
+        added = 0
+        for offset in range(count):
+            i = (turn + offset) % count
+            if not copied[i] and lengths[i] < len(drafts[i]):
+                lengths[i] += 1
+                left -= 1
+                added += 1
+                if not left:
+                    break
+        if not added:
+            break
+    return [chain[:n] for chain, n in zip(drafts, lengths)], before
+
