+def _stray_open(text: str, start: int) -> int:
+    """Where the ``<tool_call>`` at ``start`` turns out to be text: the next ``<tool_call>`` or ``</think>`` in its name
+    part (before its first ``<arg_key>`` and its ``</tool_call>``), else -1. An argument's value may hold either."""
+
+    body = start + len(_CALL_OPEN)
+    ends = [at for at in (text.find("<arg_key>", body), text.find(_CALL_CLOSE, body)) if at >= 0]
+    name_end = min(ends) if ends else len(text)
+    found = [at for at in (text.find(_CALL_OPEN, body, name_end), text.find(_THINK_CLOSE, body, name_end)) if at >= 0]
+    return min(found) if found else -1
+
