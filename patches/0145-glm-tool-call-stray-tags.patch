+def _call_block(text: str, pos: int) -> int:
+    """The end of the whole call block at ``pos``, or -1 (none, or an opener written as text: ``_stray_open``)."""
+
+    block = _CALL_BLOCK.match(text, pos)
+    return block.end() if block is not None and _stray_open(text, pos) < 0 else -1
+
+
+def _maybe_call(text: str, at: int) -> bool:
+    """Whether the unclosed ``<tool_call>`` at ``at`` may still be a GLM call being written: its name part so far is
+    a name (an opener followed by words is text the model wrote, held neither as a call nor out of the reasoning)."""
+
+    body = at + len(_CALL_OPEN)
+    ends = [end for end in (text.find("<arg_key>", body), text.find(_CALL_CLOSE, body)) if end >= 0]
+    name = text[body:min(ends)] if ends else text[body:]
+    if not ends:                                # less a tail that may begin <arg_key> or </tool_call>
+        name = name[:len(name) - max(_partial_tag(name, "<arg_key>"), _partial_tag(name, _CALL_CLOSE))]
+    name = name.strip()
+    return _stray_open(text, at) < 0 and (not name or _GLM_NAME.fullmatch(name) is not None)
