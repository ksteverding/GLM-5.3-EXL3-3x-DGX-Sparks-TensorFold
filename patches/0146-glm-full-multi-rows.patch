+def full_max_rows(value: str | None = None) -> int:
+    """TF_GLM_MULTI_ROWS: the rows full GLM-5.3's batched verify takes at most a round, every stream's window together,
+    16 (default) to TF_GLM_MAX_ROWS in steps of 8. Up to 16 rows every row-independent kernel keeps the tile it runs a
+    lone stream's window on (qmm's 16-row bucket, the absorb's one row a program, 16-head attention tiles), so the bits
+    cannot move with the window's size; past it the tiles change (tools/exact.py checks that replies still equal their
+    serial references). Past 16 rows the all-gathers also need TF_ROCE_MAX_KB raised (16 KiB a row) to stay on RoCE."""
+
+    from .engine import MAX_ROWS
 
+    value = (os.environ.get("TF_GLM_MULTI_ROWS", "") if value is None else value).strip()
+    if value == "":
+        return 16
+    if not value.isdecimal() or not 16 <= int(value) <= MAX_ROWS or int(value) % 8:
+        raise ValueError(f"TF_GLM_MULTI_ROWS: 16 to TF_GLM_MAX_ROWS ({MAX_ROWS}) in steps of 8, not {value!r}")
+    return int(value)
 
+
+# full GLM-5.3: the rows a batched window takes at most (TF_GLM_MULTI_ROWS)
+FULL_MAX_ROWS = full_max_rows()
